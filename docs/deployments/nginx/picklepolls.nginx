server {
	server_name picklepolls.go2courts.com;

	location / {
		proxy_pass http://127.0.0.1:8020;
        proxy_set_header X-Forwarded-Proto $scheme;
		include proxy_params;
	}


	location /static/ {
		alias /home/ubuntu/picklepolls/project/staticfiles/;
	}

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/picklepolls.go2courts.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/picklepolls.go2courts.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = picklepolls.go2courts.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


	server_name picklepolls.go2courts.com;
    listen 80;
    return 404; # managed by Certbot


}