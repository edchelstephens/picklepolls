// =========================================================
// DOCKER DISCOVERY
// =========================================================

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}


// =========================================================
// DOCKER LOG LABELS
// =========================================================

// Use Docker container name as the service name.
discovery.relabel "docker_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service_name"
  }
}


// =========================================================
// DOCKER LOG COLLECTION
// =========================================================

loki.source.docker "containers" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.relabel.docker_logs.output

  labels = {
    platform = "docker",
  }

  forward_to = [loki.write.local.receiver]
}


// =========================================================
// LOKI
// =========================================================

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}


// =========================================================
// OTLP TRACE RECEIVER
// =========================================================

// Django sends OTLP/HTTP traces to:
//     http://alloy:4318
//
// We also expose OTLP/gRPC on :4317 for other applications.

otelcol.receiver.otlp "traces" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}


// =========================================================
// TRACE BATCH PROCESSOR
// =========================================================

// Batch spans before sending them to Tempo.

otelcol.processor.batch "traces" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}


// =========================================================
// TEMPO TRACE EXPORTER
// =========================================================

// Alloy → Tempo
//
// Tempo is reachable inside Docker at:
//     tempo:4317

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}